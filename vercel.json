{
  "builds": [
    {
      "src": "backend/app.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["model/**", "data/**"] }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    { "src": "/api", "dest": "/backend/app.py" },
    { "src": "/api/(.*)", "dest": "/backend/app.py" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
