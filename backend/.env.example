# Copy this file to .env and fill in real values for local development.
# In production, set these as environment variables on your hosting
# platform (Vercel/Render/Railway project settings) instead of a .env file.

# Required for live current + forecast rainfall lookups (openweathermap.org).
# Without it, predictions still work but silently fall back to each
# village's historical CHIRPS rainfall average.
OPENWEATHER_API_KEY=

# Optional overrides — only needed if you move the model/data files
# somewhere other than the repo's default ../model and ../data folders.
# MODEL_PATH=
# VILLAGE_DATA_PATH=
